<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=1080, height=920">
  <!--
    ╔══════════════════════════════════════════════════════════════════════════════╗
    ║ SECTION-TÉMOIN — une idée rendue visible (ici : le dérush)                     ║
    ╠══════════════════════════════════════════════════════════════════════════════╣
    ║ POUR CRÉER TA PROCHAINE SECTION :                                              ║
    ║  1. Duplique ce fichier (ex. compositions/ta-section.html).                    ║
    ║  2. Renomme l'id PARTOUT : #exemple-section → #ta-section (CSS + HTML +        ║
    ║     data-composition-id + la constante ID du script).                          ║
    ║  3. Cale data-start / data-duration sur les frontières de                      ║
    ║     derush/<video>_cuts.json (JAMAIS les timestamps Whisper).                  ║
    ║  4. Garde les invariants [1]-[7] ci-dessous : ce sont les pièges qui cassent   ║
    ║     le render au montage par couches.                                          ║
    ║  5. Change le SUJET : ce geste (onde brute → prises assemblées) illustre le    ║
    ║     dérush. Ta section illustre SON idée (cf. references/premier-montage.md).  ║
    ║                                                                                ║
    ║ Format : SPLIT-SCREEN (1080×920). Le motion vit dans le HAUT (cette comp) ;    ║
    ║ le visage du créateur occupe le BAS de l'écran (calque du master).             ║
    ╚══════════════════════════════════════════════════════════════════════════════╝
  -->
  <!-- GSAP est aussi chargé dans le head du master : au render par couches, les scripts externes
       d'une sous-comp ne sont PAS chargés. Toute lib tierce ajoutée ici va AUSSI dans le master. -->
  <script src="assets/vendor/gsap.min.js"></script>
  <!-- Polices + tokens de marque : indispensables pour que var(--brand-*) se résolve
       dans le studio ET au render par couches (le master les charge aussi). -->
  <link rel="stylesheet" href="brand/fonts.css">
  <link rel="stylesheet" href="brand/tokens.css">
  <style>
    /* [7] ⛔ AUCUNE règle sur html/body ici (surtout pas `height: 920px`).
       Au render, TOUTES les sous-comps sont injectées dans UN SEUL document : un style posé
       sur body par un split écraserait celui des plein-écrans → calque rogné. La taille se
       pose sur la racine SCOPÉE (#exemple-section).
       [2] Tout le CSS est SCOPÉ sous #exemple-section. Les classes internes (.label, .wave…)
       reviennent d'une section à l'autre : sans scope, la suivante hérite de ces styles au
       render. JAMAIS d'id nu type #wave (collision entre sections).
       [5] La racine n'a PAS de fond : elle est au-dessus du visage (bug « carré noir »).
       Le seul aplat opaque plein cadre autorisé = #bgbase du master.
       Les formes d'onde sont illustratives, pas des mesures d'une vidéo client. */
    #exemple-section { position:absolute; inset:0; width:1080px; height:920px; overflow:hidden;
      color:var(--brand-text); font-family:var(--brand-font-body); }
    #exemple-section * { box-sizing:border-box; }
    /* [6] Safe-zones : rien d'important dans les ~150 px du haut (Instagram y pose le nom du
       compte) ni à moins de var(--brand-safe-x) des bords (Instagram recadre les côtés). */
    #exemple-section .eyebrow { position:absolute; top:196px; left:var(--brand-safe-x); right:var(--brand-safe-x);
      display:flex; align-items:baseline; justify-content:space-between; }
    /* Tailles = hiérarchie du skill motion-design §3 (×1,4 en vertical) : titre ≈ 64 px Black,
       labels 40 px Black, métadonnées 28 px minimum. Rien sous 28 px : c'est vu sur un téléphone. */
    #exemple-section .title { font-size:64px; line-height:1; font-weight:900; letter-spacing:-0.5px; }
    #exemple-section .edition { font-size:28px; font-weight:600; letter-spacing:1px; }
    /* Contraste : l'encre d'abord. Texte et contours porteurs de sens en --brand-text ;
       --brand-surface seulement en aplat discret ; jamais de gris sur gris. */
    #exemple-section .paper { position:absolute; left:var(--brand-safe-x); right:var(--brand-safe-x);
      top:296px; height:540px; border:3px solid var(--brand-text); border-radius:28px;
      background:var(--brand-bg); }
    #exemple-section .label { position:absolute; left:40px; font-size:40px; line-height:1.1;
      font-weight:900; letter-spacing:1px; margin:0; }
    #exemple-section .raw-label { top:34px; }
    #exemple-section .final-label { top:318px; }
    #exemple-section .wave { position:absolute; left:40px; width:796px; height:124px; }
    #exemple-section .wave-raw { top:100px; }
    #exemple-section .wave-final { top:384px; }
    #exemple-section .bar { fill:var(--brand-text); }
    #exemple-section .final-bar { fill:var(--brand-contrast); }
    #exemple-section .gaps { position:absolute; inset:0; }
    /* Un silence = une onde plate, sur un aplat discret. */
    #exemple-section .gap { position:absolute; top:106px; height:112px; width:54px;
      border-radius:14px; background:var(--brand-surface); }
    #exemple-section .gap::after { content:""; position:absolute; left:10px; right:10px; top:54px;
      height:4px; border-radius:2px; background:var(--brand-text); }
    #exemple-section .gap-a { left:275px; }
    #exemple-section .gap-b { left:539px; }
    #exemple-section .gap-caption { position:absolute; top:244px; left:40px; margin:0;
      font-size:32px; line-height:1.2; font-weight:600; }
    #exemple-section .connector { position:absolute; right:56px; top:240px; width:44px;
      height:64px; color:var(--brand-text); }
    #exemple-section .result { position:absolute; left:32px; top:382px; width:812px; height:128px;
      border-radius:20px; background:var(--brand-accent); }
    #exemple-section .done { position:absolute; right:44px; top:318px; width:44px; height:44px;
      color:var(--brand-accent); }
  </style>
</head>
<body>
  <!-- data-duration = durée de CETTE section, lue sur derush/exemple_cuts.json (0 → 8.0 s). -->
  <div id="exemple-section" data-composition-id="exemple-section" data-start="0" data-duration="8"
       data-fps="30" data-width="1080" data-height="920">
    <!-- [1] Élément timé visible → class="clip" + data-start / data-duration / data-track-index.
         Sans class="clip", le framework ne contrôle pas sa visibilité (reste peint au render). -->
    <div id="exemple-panel" class="clip" data-start="0" data-duration="8" data-track-index="0">
      <div class="eyebrow"><span class="title">AVANT / APRÈS</span><span class="edition">01 / DÉRUSH</span></div>
      <div class="paper">
        <p class="label raw-label">PRISE BRUTE</p>
        <svg class="wave wave-raw" viewBox="0 0 796 124" aria-label="Trois prises séparées par des silences"></svg>
        <div class="gaps"><div class="gap gap-a"></div><div class="gap gap-b"></div>
          <p class="gap-caption">Les silences s'effacent</p></div>
        <svg class="connector" viewBox="0 0 44 64" fill="none" aria-hidden="true">
          <path d="M22 4v48M8 40l14 14 14-14" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <p class="label final-label">PRISES ASSEMBLÉES</p>
        <div class="result"></div>
        <svg class="wave wave-final" viewBox="0 0 796 124" aria-label="Les trois prises assemblées, sans les silences"></svg>
        <svg class="done" viewBox="0 0 40 40" fill="none" aria-hidden="true">
          <circle cx="20" cy="20" r="18" stroke="currentColor" stroke-width="2.5"/>
          <path class="check" d="M11 20l6 6 12-13" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" pathLength="1"/>
        </svg>
      </div>
    </div>
  </div>
  <script>
    // [3] Timeline GSAP PAUSED, dans une IIFE, enregistrée sur window.__timelines[ID].
    //     L'IIFE est OBLIGATOIRE : au render toutes les sous-comps partagent la portée globale ;
    //     un `const tl` au top-level → "Identifier 'tl' has already been declared" sur la 2e
    //     section → son script ne tourne jamais (timeline muette, éléments figés à l'état CSS).
    (function () {
      var ID = 'exemple-section'; // à renommer en même temps que le CSS et le HTML
      var scope = '#' + ID + ' ';
      // Formes et timings déterministes : ni hasard, ni réseau, ni mesure pendant les tweens.
      var root = document.getElementById(ID);
      var heights = [22,38,62,84,48,108,74,42,94,56,32,70,102,60,40,82,114,68];
      var raw = root.querySelector('.wave-raw');
      var finalWave = root.querySelector('.wave-final');
      for (var group = 0; group < 3; group++) {
        for (var i = 0; i < 18; i++) {
          var h = heights[(i + group * 5) % heights.length];
          var bar = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
          bar.setAttribute('x', 34 + group * 264 + i * 11);
          bar.setAttribute('y', (124 - h) / 2);
          bar.setAttribute('width', 6); bar.setAttribute('height', h); bar.setAttribute('rx', 3);
          bar.setAttribute('class', 'bar raw-bar'); raw.appendChild(bar);
          var copy = bar.cloneNode();
          copy.setAttribute('x', 12 + (group * 18 + i) * 14.4);
          copy.setAttribute('class', 'final-bar'); finalWave.appendChild(copy);
        }
      }
      window.__timelines = window.__timelines || {};
      var tl = gsap.timeline({paused:true});
      // [4] Entrées via opacity + scale UNIQUEMENT, jamais x/y : dans une sous-comp posée par le
      //     studio, un translate x/y se cumule avec celui du host → décalage.
      //     fromTo() (et non from()) : au montage par couches, l'état de départ doit être explicite.
      //     UN SEUL sélecteur par tween : tl.to([sel1, sel2]) est ignoré sans erreur dans une sous-comp.
      tl.fromTo(scope+'.eyebrow', {opacity:0}, {opacity:1,duration:.25}, 0);
      tl.fromTo(scope+'.paper', {opacity:0,scale:.96}, {opacity:1,scale:1,duration:.38,ease:'expo.out'}, .08);
      tl.fromTo(scope+'.raw-bar', {scaleY:.08,transformOrigin:'50% 50%'}, {scaleY:1,duration:.45,stagger:.009,ease:'power3.out'}, .3);
      tl.fromTo(scope+'.gaps', {opacity:0}, {opacity:1,duration:.25}, 2.2);
      tl.to(scope+'.gap', {scaleX:0,opacity:0,duration:.4,ease:'power3.in'}, 3.4);
      tl.to(scope+'.gap-caption', {opacity:0,duration:.2}, 4.1);
      tl.fromTo(scope+'.connector', {opacity:0,scale:.85}, {opacity:1,scale:1,duration:.3,ease:'expo.out'}, 4.25);
      tl.fromTo(scope+'.final-label', {opacity:0}, {opacity:1,duration:.2}, 4.6);
      tl.fromTo(scope+'.result', {opacity:0,scaleX:.92}, {opacity:1,scaleX:1,duration:.35,ease:'expo.out'}, 4.7);
      tl.fromTo(scope+'.final-bar', {opacity:0,scaleY:.05,transformOrigin:'50% 50%'}, {opacity:1,scaleY:1,duration:.4,stagger:.008,ease:'power3.out'}, 4.85);
      tl.fromTo(scope+'.done', {opacity:0,scale:.75}, {opacity:1,scale:1,duration:.3,ease:'back.out(1.4)'}, 6);
      tl.fromTo(scope+'.check', {strokeDasharray:1,strokeDashoffset:1}, {strokeDashoffset:0,duration:.35,ease:'power2.out'}, 6.2);
      window.__timelines[ID] = tl;
    })();
  </script>
</body>
</html>
