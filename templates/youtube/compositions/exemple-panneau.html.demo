<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=960, height=1080">
  <!--
    ╔══════════════════════════════════════════════════════════════════════════════╗
    ║ PANNEAU-TÉMOIN d'une section « cote » (vidéo YouTube 1920×1080)                ║
    ╠══════════════════════════════════════════════════════════════════════════════╣
    ║ Le créateur glisse sur la moitié gauche, ce panneau (960×1080) entre à droite  ║
    ║ dans le même geste : 0,6 s, power2.inOut, comme le glissement du master.       ║
    ║                                                                                ║
    ║ POUR CRÉER TON PANNEAU :                                                       ║
    ║  1. Duplique ce fichier (compositions/<id de la section>.html).                ║
    ║  2. Renomme l'id PARTOUT : #exemple-panneau → #<id> (CSS, HTML,                ║
    ║     data-composition-id, constante ID du script).                              ║
    ║  3. data-duration = durée de SA section (tools/sections.py).                   ║
    ║  4. Garde les invariants [1] à [7] : ce sont les pièges du rendu par couches.  ║
    ║  5. Change le SUJET : une carte qui se construit pendant tout le sujet         ║
    ║     (20 à 40 s), pas un texte qui redit la voix.                               ║
    ║  Panneau à GAUCHE ("panneau": "gauche") : COTE = 'gauche' dans le script.      ║
    ╚══════════════════════════════════════════════════════════════════════════════╝
  -->
  <script src="assets/vendor/gsap.min.js"></script>
  <link rel="stylesheet" href="brand/fonts.css">
  <link rel="stylesheet" href="brand/tokens.css">
  <style>
    /* [7] AUCUNE règle sur html/body : au rendu, toutes les sous-compositions partagent UN document.
       [2] Tout est SCOPÉ sous #exemple-panneau, les éléments internes sont des classes.
       [5] Le panneau peut être opaque : il ne couvre que la moitié libre, jamais le visage. */
    #exemple-panneau { position:absolute; inset:0; width:960px; height:1080px; overflow:hidden;
      color:var(--brand-text); font-family:var(--brand-font-body); }
    /* Le fond du panneau glisse depuis le bord de l'écran : x d'un conteneur INTERNE (l'app déplace
       la racine), jamais un clip-path ni un masque animés : ils font passer l'export sur un seul
       processeur, deux à trois fois plus long. */
    #exemple-panneau .pan { position:absolute; inset:0; background:var(--brand-bg); }
    #exemple-panneau * { box-sizing:border-box; }
    /* [6] Zones YouTube : textes dans la zone titre (10 %), rien de permanent dans les 150 px du bas
       (barre de lecture). Côté écran : 192 px du bord extérieur, 72 px côté visage. */
    #exemple-panneau .inner { position:absolute; left:72px; right:var(--brand-yt-title-x);
      top:var(--brand-yt-title-y); bottom:calc(var(--brand-yt-player) + 40px);
      display:flex; flex-direction:column; justify-content:center; gap:40px; }
    /* Tailles en 16:9 : titre 64 px Black, lignes 40 px, détail 28 px. Lisible sur un téléphone
       tenu à l'horizontale comme sur une télé. */
    #exemple-panneau .kicker { font-size:28px; font-weight:700; letter-spacing:3px; color:var(--brand-muted);
      text-transform:uppercase; margin:0; }
    #exemple-panneau .title { font-size:64px; line-height:1.02; font-weight:900; letter-spacing:-0.5px; margin:0; }
    #exemple-panneau .list { display:flex; flex-direction:column; gap:22px; margin:0; padding:0; list-style:none; }
    #exemple-panneau .row { position:relative; display:flex; align-items:center; gap:24px; padding:22px 26px;
      border-radius:22px; border:3px solid var(--brand-text); background:var(--brand-bg); overflow:hidden; }
    #exemple-panneau .row > span { position:relative; }
    #exemple-panneau .num { flex:none; width:58px; height:58px; border-radius:50%; display:flex;
      align-items:center; justify-content:center; font-size:30px; font-weight:900;
      background:var(--brand-accent); color:var(--brand-contrast); }
    #exemple-panneau .label { font-size:40px; font-weight:800; line-height:1.1; }
    /* Surlignage de la ligne dont on parle : un aplat sous le texte, animé en opacité. */
    #exemple-panneau .hl { position:absolute !important; inset:0; background:var(--brand-surface); opacity:0; }
  </style>
</head>
<body>
  <!-- data-duration = durée de la section « exemple-panneau » de la démo (3,0 → 6,0 s). -->
  <div id="exemple-panneau" data-composition-id="exemple-panneau" data-start="0" data-duration="3"
       data-fps="30" data-width="960" data-height="1080">
    <!-- [1] Élément timé visible : class="clip" + data-start / data-duration / data-track-index. -->
    <div class="pan">
    <div id="exemple-panneau-carte" class="inner clip" data-start="0" data-duration="3" data-track-index="0">
      <p class="kicker">Ta vidéo YouTube</p>
      <h2 class="title">Trois gestes de montage</h2>
      <ul class="list">
        <li class="row r1"><span class="num">1</span><span class="label">Les blancs coupés</span></li>
        <li class="row r2"><span class="num">2</span><span class="label">Le cadre qui change</span></li>
        <li class="row r3"><span class="hl"></span><span class="num">3</span><span class="label">Le schéma à côté de toi</span></li>
      </ul>
    </div>
    </div>
  </div>
  <script>
    // [3] Timeline PAUSED dans une IIFE, enregistrée sur window.__timelines[ID].
    (function () {
      var ID = 'exemple-panneau';
      var COTE = 'droite';   // côté du panneau dans tools/sections.py ("panneau": "gauche" -> 'gauche')
      var s = '#' + ID + ' ';
      window.__timelines = window.__timelines || {};
      var tl = gsap.timeline({ paused: true });
      // L'entrée du panneau = le même geste que le glissement du créateur (master) : 0,6 s, power2.inOut.
      // Le panneau part du bord de l'écran (x du conteneur interne .pan, jamais de la racine).
      tl.fromTo(s + '.pan', { x: COTE === 'gauche' ? -960 : 960 }, { x: 0, duration: 0.6, ease: 'power2.inOut' }, 0);
      // [4] Entrées en opacity + scale ; UN SEUL sélecteur par tween ; fromTo explicites.
      tl.fromTo(s + '.kicker', { opacity: 0 }, { opacity: 1, duration: 0.25 }, 0.35);
      tl.fromTo(s + '.title', { opacity: 0, scale: 0.97 }, { opacity: 1, scale: 1, duration: 0.35, ease: 'expo.out' }, 0.42);
      tl.fromTo(s + '.r1', { opacity: 0, scale: 0.96 }, { opacity: 1, scale: 1, duration: 0.3, ease: 'expo.out' }, 0.8);
      tl.fromTo(s + '.r2', { opacity: 0, scale: 0.96 }, { opacity: 1, scale: 1, duration: 0.3, ease: 'expo.out' }, 1.3);
      tl.fromTo(s + '.r3', { opacity: 0, scale: 0.96 }, { opacity: 1, scale: 1, duration: 0.3, ease: 'expo.out' }, 1.8);
      // La ligne dont on parle s'allume : la carte suit la voix au lieu de tout montrer d'un coup.
      tl.fromTo(s + '.hl', { opacity: 0 }, { opacity: 1, duration: 0.3 }, 2.1);
      // Sortie : le contenu s'efface juste avant la fin de la section (ici 3 s) ; le fond reste, et le
      // créateur glisse par-dessus en revenant au centre (le master anime ce retour après la coupe).
      tl.fromTo(s + '.inner', { opacity: 1 }, { opacity: 0, duration: 0.22, ease: 'power2.in', immediateRender: false }, 3 - 0.24);
      window.__timelines[ID] = tl;
    })();
  </script>
</body>
</html>
